# Template only: export variables or use a service EnvironmentFile; .env is not auto-loaded.
# Example: EXPENSE_TRACKER_DB=/home/you/data/expense_tracker.db
EXPENSE_TRACKER_DB=/path/to/expense_tracker.db

# Local AI (export variables or load via your service EnvironmentFile; no automatic .env loading)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_NUM_GPU=25
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=400
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_RESPONSE_TIMEOUT=120
